# AI Support Student - environment configuration
#
# No external API keys are required. The RAG system uses a local
# TF-IDF vector store (no embedding API calls), and the ML model runs
# locally via scikit-learn. This file is provided for future extension
# (e.g. swapping in a remote embedding provider) and for consistency
# with the required project structure.

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Paths (defaults shown; usually no need to change) ---
DATA_PATH=data/dataset.csv
POLICY_PDF_PATH=documents/policies/Policies_and_Guidelines.pdf
MODELS_DIR=models
VECTOR_STORE_PATH=rag/vector_store/policy_store.pkl

# --- Reproducibility ---
RANDOM_SEED=42
